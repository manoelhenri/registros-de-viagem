---
layout: base.njk
title: "Parques"
nav: parques
---
{% set totalParques = 0 %}
{% for grupo in parques %}{% set totalParques = totalParques + grupo.parques.length %}{% endfor %}

<nav class="breadcrumb" aria-label="Você está aqui">
  <a href="{{ '/' | url }}">Início</a>
  <span class="sep">→</span>
  <span class="here">Parques</span>
</nav>

<div class="page-hero">
  <span class="eyebrow">{{ totalParques }} parques · temáticos e aquáticos</span>
  <h1>De montanha-russa em montanha-russa.</h1>
  <p class="lede">Todo parque temático e aquático já visitado, do Brasil ao exterior.</p>

  <div class="filter-bar">
    <input type="search" id="parqueSearch" class="filter-search" placeholder="Buscar parque..." aria-label="Buscar parque">
    <div class="filter-chips" id="parqueFiltrosGrupo">
      <button type="button" class="filter-chip is-active" data-grupo="todos">Todos os grupos</button>
      {% for grupo in parques %}
      <button type="button" class="filter-chip" data-grupo="{{ grupo.id }}">{{ grupo.icone }} {{ grupo.grupo }}</button>
      {% endfor %}
    </div>
  </div>

  <div class="country-jump">
    {% for grupo in parques %}
    <a href="#{{ grupo.id }}">{{ grupo.icone }} {{ grupo.grupo }}</a>
    {% endfor %}
  </div>
</div>

<p class="no-results" id="parqueNoResults" role="status" aria-live="polite" hidden>Nenhum parque encontrado. <button type="button" id="parqueLimpar" class="link-button">Limpar filtros</button></p>

{% for grupo in parques %}
<section class="country-section" id="{{ grupo.id }}" data-grupo-section="{{ grupo.id }}">
  <div class="country-title">
    <span class="flag">{{ grupo.icone }}</span>
    <h2>{{ grupo.grupo }}</h2>
    <span class="n">{{ grupo.parques.length | pad2 }} parque{% if grupo.parques.length != 1 %}s{% endif %}</span>
  </div>
  <div class="place-grid">
    {% for parque in grupo.parques %}
    {% set slug = parque.nome | slugify %}
    {% set viagens = parque.nome | postsDoParque(collections.posts) %}
    <div class="place-card" id="parque-{{ slug }}" data-grupo="{{ grupo.id }}" data-search="{{ (parque.nome + ' ' + parque.local + ' ' + parque.resumo) | lower }}">
      {% if parque.foto %}
        <img src="{{ parque.foto }}" alt="{{ parque.nome }}" loading="lazy" decoding="async" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-bottom:1px solid var(--line);">
      {% else %}
        <div class="img-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
        </div>
      {% endif %}
      <div class="place-body">
        <h3><a href="{{ '/parques/' | url }}{{ slug }}/">{{ parque.nome }}</a></h3>
        <span class="place-state">{{ parque.local }}</span>
        {% if parque.anos.length %}
        <div class="year-chips">
          {% for ano in parque.anos %}<span class="year-chip">{{ ano }}</span>{% endfor %}
        </div>
        {% endif %}
        <p>{{ parque.resumo }}</p>
        <a class="related-link" href="{{ '/parques/' | url }}{{ slug }}/">Ver página do parque →</a>
        {% if viagens.length %}
        <a class="related-link" href="{{ viagens[0].url }}">
          {% if viagens.length == 1 %}Ver viagem relacionada →{% else %}Ver {{ viagens.length }} viagens relacionadas →{% endif %}
        </a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endfor %}

<script>
(function () {
  var search = document.getElementById('parqueSearch');
  var chips = document.querySelectorAll('#parqueFiltrosGrupo .filter-chip');
  var cards = Array.prototype.slice.call(document.querySelectorAll('.place-card[data-grupo]'));
  var sections = Array.prototype.slice.call(document.querySelectorAll('[data-grupo-section]'));
  var noResults = document.getElementById('parqueNoResults');
  var limparBtn = document.getElementById('parqueLimpar');
  var grupoAtivo = 'todos';

  function aplicarFiltros() {
    var termo = (search.value || '').trim().toLowerCase();
    var visiveis = 0;

    cards.forEach(function (card) {
      var bateGrupo = grupoAtivo === 'todos' || card.getAttribute('data-grupo') === grupoAtivo;
      var bateTermo = !termo || card.getAttribute('data-search').indexOf(termo) !== -1;
      var mostrar = bateGrupo && bateTermo;
      card.style.display = mostrar ? '' : 'none';
      if (mostrar) visiveis++;
    });

    sections.forEach(function (section) {
      var temVisivel = section.querySelectorAll('.place-card:not([style*="display: none"])').length > 0;
      section.style.display = temVisivel ? '' : 'none';
    });

    noResults.hidden = visiveis !== 0;
  }

  if (search) search.addEventListener('input', aplicarFiltros);

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      chips.forEach(function (c) { c.classList.remove('is-active'); });
      chip.classList.add('is-active');
      grupoAtivo = chip.getAttribute('data-grupo');
      aplicarFiltros();
    });
  });

  if (limparBtn) {
    limparBtn.addEventListener('click', function () {
      search.value = '';
      chips.forEach(function (c) { c.classList.remove('is-active'); });
      chips[0].classList.add('is-active');
      grupoAtivo = 'todos';
      aplicarFiltros();
    });
  }
})();
</script>
