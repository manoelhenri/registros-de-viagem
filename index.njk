---
layout: base.njk
title: "Início"
nav: inicio
---
{# Letreiro do hero: usa a lista manual editada no painel (home.heroDestinos,
   até 6 nomes) quando ela existir e tiver pelo menos 1 item; senão, cai no
   automático (últimos destinos reais dos posts). #}
{% set heroDestinosManual = home.heroDestinos %}
{% set heroLugares = heroDestinosManual.slice(0, 6) if heroDestinosManual and heroDestinosManual.length else (collections.posts | heroDestinosRecentes(5)) %}
<header class="hero">
  <div class="hero-content">
    <span class="eyebrow">{{ home.heroEyebrow }}</span>
    <h1>{{ home.heroTitulo }}</h1>
    <p class="lede">{{ home.heroSubtitulo }}</p>
    {% if heroLugares.length %}
    <div class="hero-solari" aria-hidden="true">
      <span class="hero-solari-label">Últimos destinos</span>
      <div class="hero-solari-row" id="heroSolariRow"></div>
    </div>
    <span class="visually-hidden" id="heroSolariSr">Últimos destinos: {{ heroLugares[heroLugares.length - 1] | upper }}</span>
    {% endif %}
  </div>
</header>

{% if heroLugares.length %}
<script>
(function () {
  var lugares = {{ heroLugares | dump | safe }}.map(function (s) { return String(s).toUpperCase(); });
  var row = document.getElementById("heroSolariRow");
  var sr = document.getElementById("heroSolariSr");
  if (!row || !lugares.length) return;

  var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var alfabeto = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  function letraAleatoria() { return alfabeto[Math.floor(Math.random() * alfabeto.length)]; }

  function criarCelula(letra) {
    var cell = document.createElement("div");
    cell.className = "hero-solari-cell";
    cell.textContent = letra;
    return cell;
  }

  var cells = [];
  lugares[0].split("").forEach(function (letra) {
    var cell = criarCelula(letra);
    row.appendChild(cell);
    cells.push(cell);
  });

  if (lugares.length < 2 || reduceMotion) return;

  function flipParaLetra(cell, letraFinal, giros) {
    var passo = 0;
    (function proximoGiro() {
      cell.classList.remove("flip");
      void cell.offsetWidth;
      cell.classList.add("flip");
      setTimeout(function () {
        passo++;
        if (passo < giros) {
          cell.textContent = letraAleatoria();
          setTimeout(proximoGiro, 90);
        } else {
          cell.textContent = letraFinal;
        }
      }, 175);
    })();
  }

  function criarCelulaEntrando(letraFinal) {
    var cell = document.createElement("div");
    cell.className = "hero-solari-cell";
    cell.textContent = letraFinal;
    cell.style.width = "0px";
    cell.style.opacity = "0";
    cell.style.overflow = "hidden";
    row.appendChild(cell);
    void cell.offsetWidth;
    cell.style.transition = "width 0.3s ease, opacity 0.3s ease";
    requestAnimationFrame(function () {
      cell.style.width = "22px";
      cell.style.opacity = "1";
    });
    setTimeout(function () {
      cell.style.width = "";
      cell.style.opacity = "";
      cell.style.overflow = "";
      cell.style.transition = "";
    }, 320);
    return cell;
  }

  function removerCelula(cell) {
    cell.style.overflow = "hidden";
    cell.style.transition = "width 0.28s ease, opacity 0.28s ease";
    void cell.offsetWidth;
    requestAnimationFrame(function () {
      cell.style.width = "0px";
      cell.style.opacity = "0";
    });
    setTimeout(function () {
      if (cell.parentNode) cell.parentNode.removeChild(cell);
    }, 300);
  }

  var indice = 0;
  setInterval(function () {
    indice = (indice + 1) % lugares.length;
    var alvo = lugares[indice];
    var atualLen = cells.length;
    var alvoLen = alvo.length;
    var comum = Math.min(atualLen, alvoLen);

    for (var idx = 0; idx < comum; idx++) {
      (function (idx) {
        var giros = 2 + Math.floor(Math.random() * 2);
        setTimeout(function () { flipParaLetra(cells[idx], alvo[idx], giros); }, idx * 65);
      })(idx);
    }

    if (alvoLen > atualLen) {
      for (var idxNova = atualLen; idxNova < alvoLen; idxNova++) {
        (function (idxNova) {
          setTimeout(function () { cells.push(criarCelulaEntrando(alvo[idxNova])); }, idxNova * 65);
        })(idxNova);
      }
    } else if (atualLen > alvoLen) {
      var saindo = cells.slice(alvoLen);
      cells = cells.slice(0, alvoLen);
      saindo.forEach(function (cell, i) {
        setTimeout(function () { removerCelula(cell); }, i * 65);
      });
    }

    if (sr) sr.textContent = "Últimos destinos: " + alvo;
  }, 4200);
})();
</script>
{% endif %}

{% set destaque = collections.postoDestaque %}
{% if destaque %}
<section class="featured">
  <a class="featured-card" href="{{ destaque.url }}" style="text-decoration:none; color:inherit;">
    {% if destaque.data.capa %}
      <img src="{{ destaque.data.capa }}" alt="{{ destaque.data.title }}" fetchpriority="high" decoding="async">
    {% else %}
      <div class="img-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
      </div>
    {% endif %}
    <div class="featured-text">
      <span class="coords">{{ destaque.data.coordenadas }}</span>
      <h3>{{ destaque.data.title }}</h3>
      <p>{{ destaque.data.resumo }}</p>
      <span class="read-link">Ler o post →</span>
    </div>
  </a>
</section>
{% endif %}

<section class="explore-grid">
  <a class="explore-card" href="{{ '/destinos/' | url }}">
    <span class="eyebrow">{{ estatisticas.totalDestinos }} {% if estatisticas.totalDestinos == 1 %}destino{% else %}destinos{% endif %} · {{ estatisticas.totalPaises }} {% if estatisticas.totalPaises == 1 %}país{% else %}países{% endif %}</span>
    <h3>{{ home.card1Titulo }}</h3>
    <p>{{ home.card1Texto }}</p>
    <span class="arrow">Explorar destinos →</span>
  </a>
  <a class="explore-card alt" href="{{ '/parques/' | url }}">
    <span class="eyebrow">{{ home.card2Eyebrow }}</span>
    <h3>{{ home.card2Titulo }}</h3>
    <p>{{ home.card2Texto }}</p>
    <span class="arrow">Explorar parques →</span>
  </a>
</section>

<div class="section-head">
  <h2>{{ home.tituloUltimosDestinos }}</h2>
  <a class="count" href="{{ '/posts/' | url }}" style="text-decoration:none;">{{ collections.posts.length | pad2 }} registros — ver todos →</a>
</div>

<section class="post-grid">
  {% for post in collections.posts.slice(0, 8) %}
  <a class="tag-card" href="{{ post.url }}">
    <span class="punch"></span>
    {% if post.data.capa %}
      <img src="{{ post.data.capa }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
    {% else %}
      <div class="img-placeholder" style="height:160px; margin-bottom:16px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
      </div>
    {% endif %}
    <span class="coords">{{ post.data.coordenadas }}</span>
    <h4>{{ post.data.title }}</h4>
    <p class="snippet">{{ post.data.resumo }}</p>
  </a>
  {% endfor %}
</section>

{% if site.instagramPosts.length %}
<section class="ig-strip">
  <div class="ig-inner">
    <div class="section-head-alt">
      <h2>{{ home.tituloInstagram }}</h2>
      <a class="ig-handle" href="{{ site.instagramUrl }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        {{ site.instagramHandle }}
      </a>
    </div>
    <div class="ig-embed-list">
      {% for post in site.instagramPosts %}
        <blockquote class="instagram-media" data-instgrm-permalink="{{ post.url }}" data-instgrm-version="14"></blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
