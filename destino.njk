---
layout: base.njk
pagination:
  data: destinosFlat
  size: 1
  alias: destino
permalink: "/destinos/{{ destino.slug }}/"
eleventyComputed:
  title: "{{ destino.nome }}"
---
{% set viagens = destino.nome | postsDaCidade(collections.posts) %}

<nav class="breadcrumb breadcrumb--narrow" aria-label="Você está aqui">
  <a href="{{ '/' | url }}">Início</a>
  <span class="sep">→</span>
  <a href="{{ '/destinos/' | url }}">Destinos</a>
  <span class="sep">→</span>
  <span class="here">{{ destino.nome }}</span>
</nav>

<div class="post-hero">
  <a class="back-link" href="{{ '/destinos/' | url }}">← voltar para todos os destinos</a>
  <span class="coords">{{ destino.bandeira }} {{ destino.pais }}</span>
  <h1>{{ destino.nome }}</h1>
  <div class="post-meta">
    <span>📍 {{ destino.estado }}</span>
    {% if destino.anos.length %}<span>📅 {{ destino.anos | join(', ') }}</span>{% endif %}
  </div>
</div>

<div class="post-cover">
  {% if destino.foto %}
    <img src="{{ destino.foto }}" alt="{{ destino.nome }}" fetchpriority="high" decoding="async">
  {% else %}
    <div class="img-placeholder" style="aspect-ratio: 21 / 9;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
    </div>
  {% endif %}
</div>

<article class="post-body">
  <p>{{ destino.resumo }}</p>
</article>

{% if destino.lat and destino.lng %}
<div class="map-embed">
  <iframe src="https://www.google.com/maps?q={{ (destino.nome + ', ' + destino.estado) | encodeURI }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen title="Mapa de {{ destino.nome }}"></iframe>
</div>
<p class="cover-credit"><a href="{{ '/mapa/' | url }}#destino-{{ destino.slug }}">Ver no mapa de todos os destinos →</a></p>
{% endif %}

{% if viagens.length %}
<section class="related-posts">
  <h2>{% if viagens.length == 1 %}A viagem que passou por aqui{% else %}As viagens que passaram por aqui{% endif %}</h2>
  <div class="post-grid">
    {% for post in viagens %}
      <a class="tag-card" href="{{ post.url }}">
        <span class="punch"></span>
        {% if post.data.capa %}
          <img src="{{ post.data.capa }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
        {% else %}
          <div class="img-placeholder" style="height:160px; margin-bottom:16px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
          </div>
        {% endif %}
        <span class="coords">{{ post.data.coordenadas }}</span>
        <h4>{{ post.data.title }}</h4>
        <p class="snippet">{{ post.data.resumo }}</p>
      </a>
    {% endfor %}
  </div>
</section>
{% else %}
<p class="no-results" style="text-align:left; padding:0;">Ainda não tem um post publicado sobre essa passagem especificamente — mas ela faz parte do histórico de destinos visitados.</p>
{% endif %}

<div class="post-nav">
  <a href="{{ '/destinos/' | url }}">← voltar para todos os destinos</a>
</div>
