---
layout: base.njk
title: "Posts"
nav: posts
---
<nav class="breadcrumb" aria-label="Você está aqui">
  <a href="{{ '/' | url }}">Início</a>
  <span class="sep">→</span>
  <span class="here">Posts</span>
</nav>

<div class="page-hero">
  <span class="eyebrow">{{ collections.posts.length | pad2 }} registros publicados</span>
  <h1>Todos os posts.</h1>
  <p class="lede">Cada viagem, do primeiro ao último dia — roteiros, aprendizados e o que vale a pena levar na mala.</p>

  <div class="filter-bar">
    <input type="search" id="postSearch" class="filter-search" placeholder="Buscar por título, lugar..." aria-label="Buscar posts">
    <div class="filter-chips" id="postFiltrosRegiao">
      <button type="button" class="filter-chip is-active" data-regiao="todos">Todos</button>
      <button type="button" class="filter-chip" data-regiao="brasil">🇧🇷 Brasil</button>
      <button type="button" class="filter-chip" data-regiao="exterior">🌎 Exterior</button>
    </div>
    <select id="postFiltroAno" class="filter-select" aria-label="Filtrar por ano">
      <option value="todos">Todos os anos</option>
      {% for ano in collections.posts | anosDosPosts %}
      <option value="{{ ano }}">{{ ano }}</option>
      {% endfor %}
    </select>
  </div>
</div>

<section class="post-grid" id="postGrid">
  {% for post in collections.posts %}
  <a class="tag-card" href="{{ post.url }}"
     data-search="{{ (post.data.title + ' ' + post.data.resumo + ' ' + post.data.coordenadas + ' ' + (post.data.cidades or '') + ' ' + (post.data.duracao or '')) | lower }}"
     data-regiao="{{ post | regiaoDoPost(destinos, parques) }}"
     data-ano="{{ post.data.data | ano }}">
    <span class="punch"></span>
    {% if post.data.capa %}
      <img src="{{ post.data.capa }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
    {% else %}
      <div class="img-placeholder" style="height:160px; margin-bottom:16px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
      </div>
    {% endif %}
    <span class="coords">{{ post.data.coordenadas }}</span>
    <h4>{{ post.data.title }}</h4>
    <p class="snippet">{{ post.data.resumo }}</p>
  </a>
  {% endfor %}
</section>
<p class="no-results" id="noResults" role="status" aria-live="polite" hidden>Nenhum post encontrado. <button type="button" id="postLimpar" class="link-button">Limpar filtros</button></p>

<script>
(function () {
  var input = document.getElementById('postSearch');
  var chips = document.querySelectorAll('#postFiltrosRegiao .filter-chip');
  var anoSelect = document.getElementById('postFiltroAno');
  var cards = Array.prototype.slice.call(document.querySelectorAll('#postGrid .tag-card'));
  var noResults = document.getElementById('noResults');
  var limparBtn = document.getElementById('postLimpar');
  var regiaoAtiva = 'todos';

  function aplicarFiltros() {
    var termo = (input.value || '').trim().toLowerCase();
    var ano = anoSelect.value;
    var visiveis = 0;

    cards.forEach(function (card) {
      var bateTermo = !termo || card.getAttribute('data-search').indexOf(termo) !== -1;
      var bateRegiao = regiaoAtiva === 'todos' || card.getAttribute('data-regiao') === regiaoAtiva;
      var bateAno = ano === 'todos' || card.getAttribute('data-ano') === ano;
      var mostrar = bateTermo && bateRegiao && bateAno;
      card.style.display = mostrar ? '' : 'none';
      if (mostrar) visiveis++;
    });

    noResults.hidden = visiveis !== 0;
  }

  if (!input) return;
  input.addEventListener('input', aplicarFiltros);
  anoSelect.addEventListener('change', aplicarFiltros);

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      chips.forEach(function (c) { c.classList.remove('is-active'); });
      chip.classList.add('is-active');
      regiaoAtiva = chip.getAttribute('data-regiao');
      aplicarFiltros();
    });
  });

  if (limparBtn) {
    limparBtn.addEventListener('click', function () {
      input.value = '';
      anoSelect.value = 'todos';
      chips.forEach(function (c) { c.classList.remove('is-active'); });
      chips[0].classList.add('is-active');
      regiaoAtiva = 'todos';
      aplicarFiltros();
    });
  }
})();
</script>
