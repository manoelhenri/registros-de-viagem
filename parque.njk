---
layout: base.njk
pagination:
  data: parquesFlat
  size: 1
  alias: parque
permalink: "/parques/{{ parque.slug }}/"
eleventyComputed:
  title: "{{ parque.nome }}"
---
{% set viagens = parque.nome | postsDoParque(collections.posts) %}
{% set relacionados = parque.nome | lugaresRelacionados(collections.posts, destinos, parques) %}

<nav class="breadcrumb breadcrumb--narrow" aria-label="Você está aqui">
  <a href="{{ '/' | url }}">Início</a>
  <span class="sep">→</span>
  <a href="{{ '/parques/' | url }}">Parques</a>
  <span class="sep">→</span>
  <span class="here">{{ parque.nome }}</span>
</nav>

<div class="post-hero">
  <a class="back-link" href="{{ '/parques/' | url }}">← voltar para todos os parques</a>
  <span class="coords">{{ parque.icone }} {{ parque.grupo }}</span>
  <h1>{{ parque.nome }}</h1>
  <div class="post-meta">
    <span>📍 {{ parque.local }}</span>
    {% if parque.anos.length %}<span>📅 {{ parque.anos | join(', ') }}</span>{% endif %}
    <span>🧳 {{ viagens.length }} {% if viagens.length == 1 %}viagem registrada{% else %}viagens registradas{% endif %}</span>
    {% if parque.anos.length %}<span>🕓 Última visita: {{ parque.anos | ultimaVisita }}</span>{% endif %}
  </div>
</div>

<div class="post-cover">
  {% if parque.foto %}
    <img src="{{ parque.foto }}" alt="{{ parque.nome }}" fetchpriority="high" decoding="async">
  {% else %}
    <div class="img-placeholder" style="aspect-ratio: 21 / 9;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
    </div>
  {% endif %}
</div>

<article class="post-body">
  <p>{{ parque.resumo }}</p>
</article>

{% if parque.lat and parque.lng %}
<div class="map-embed">
  {{ (parque.nome + ', ' + parque.local) | mapaEmbed(parque.nome) | safe }}
</div>
<p class="cover-credit"><a href="{{ '/mapa/' | url }}#parque-{{ parque.slug }}">Ver no mapa de todos os parques →</a></p>
{% endif %}

{% if relacionados.length %}
<section class="chips-section">
  <h2>Também aparece com</h2>
  <div class="chip-row">
    {% for r in relacionados %}
    {% if r.tipo == "parque" %}
    <a class="place-chip" href="{{ '/parques/' | url }}{{ r.slug }}/"><span class="pin">{{ r.icone }}</span> {{ r.nome }}</a>
    {% else %}
    <a class="place-chip" href="{{ '/destinos/' | url }}{{ r.slug }}/"><span class="pin">📍</span> {{ r.nome }}</a>
    {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if viagens.length %}
<section class="related-posts">
  <h2>{% if viagens.length == 1 %}A viagem que passou por aqui{% else %}As viagens que passaram por aqui{% endif %}</h2>
  <div class="post-grid">
    {% for post in viagens %}
      <a class="tag-card" href="{{ post.url }}">
        <span class="punch"></span>
        {% if post.data.capa %}
          <img src="{{ post.data.capa }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
        {% else %}
          <div class="img-placeholder" style="height:160px; margin-bottom:16px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
          </div>
        {% endif %}
        <span class="coords">{{ post.data.coordenadas }}</span>
        <h4>{{ post.data.title }}</h4>
        <p class="snippet">{{ post.data.resumo }}</p>
      </a>
    {% endfor %}
  </div>
</section>
{% else %}
<p class="no-results" style="text-align:left; padding:0;">Ainda não tem um post publicado sobre essa visita especificamente — mas ela faz parte do histórico de parques visitados.</p>
{% endif %}

<div class="post-nav">
  <a href="{{ '/parques/' | url }}">← voltar para todos os parques</a>
</div>
