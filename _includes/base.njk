<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set pageDescription = description or resumo or 'Diário pessoal de viagens: roteiros, destinos e parques já visitados.' %}
{% set pageUrl = site.url + page.url %}
{% set pageImage = capa or (site.url + '/images/og-cover.png') %}
{% set ogType = 'article' if resumo else 'website' %}
<title>{{ title }} — registros de viagem</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="theme-color" content="#2c5a61">
{% if page.url == '/404.html' %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ pageUrl }}">{% endif %}

<!-- Open Graph / social previews -->
<meta property="og:type" content="{{ ogType }}">
<meta property="og:title" content="{{ title }} — registros de viagem">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImage }}">
{% if not capa %}<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">{% endif %}
<meta property="og:site_name" content="registros de viagem">
<meta property="og:locale" content="pt_BR">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }} — registros de viagem">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImage }}">

<link rel="icon" type="image/svg+xml" href="{{ '/images/favicon.svg' | url }}">
<link rel="alternate" type="application/rss+xml" title="registros de viagem" href="{{ '/feed.xml' | url }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/style.css' | url }}">
</head>
<body>

<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

<nav class="site-nav">
  <a class="brand" href="{{ '/' | url }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 16l20-7-7 20-3-8-8-3z"/></svg>
    registros de viagem
  </a>
  <button class="nav-toggle" id="navToggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="navLinks">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div class="nav-links" id="navLinks">
    <a href="{{ '/' | url }}"{% if nav == 'inicio' %} aria-current="page"{% endif %}>Início</a>
    <a href="{{ '/posts/' | url }}"{% if nav == 'posts' %} aria-current="page"{% endif %}>Posts</a>
    <a href="{{ '/destinos/' | url }}"{% if nav == 'destinos' %} aria-current="page"{% endif %}>Destinos</a>
    <a href="{{ '/parques/' | url }}"{% if nav == 'parques' %} aria-current="page"{% endif %}>Parques</a>
    <a href="{{ '/mapa/' | url }}"{% if nav == 'mapa' %} aria-current="page"{% endif %}>Mapa</a>
    <a href="{{ '/timeline/' | url }}"{% if nav == 'timeline' %} aria-current="page"{% endif %}>Timeline</a>
    <a href="{{ '/sobre/' | url }}"{% if nav == 'sobre' %} aria-current="page"{% endif %}>Sobre</a>
    <a class="ig-link" href="{{ site.instagramUrl }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
      {{ site.instagramHandle }}
    </a>
  </div>
</nav>

<main id="conteudo">
{{ content | safe }}
</main>

<footer>
  <span>© {{ site.year }} {{ site.author }}</span>
  <div class="foot-links">
    <a href="{{ '/' | url }}">Início</a>
    <a href="{{ '/destinos/' | url }}">Destinos</a>
    <a href="{{ '/parques/' | url }}">Parques</a>
    <a href="{{ '/mapa/' | url }}">Mapa</a>
    <a href="{{ '/timeline/' | url }}">Timeline</a>
    <a href="{{ site.instagramUrl }}" target="_blank" rel="noopener">Instagram</a>
    <a href="{{ '/feed.xml' | url }}">RSS</a>
  </div>
</footer>

<button class="back-to-top" id="backToTop" type="button" aria-label="Voltar ao topo da página">↑ Topo</button>

<script>
(function(){
  // Floating "back to top" button: appears after scrolling down a bit.
  var topBtn = document.getElementById('backToTop');
  if (topBtn) {
    var toggleTopBtn = function(){ topBtn.classList.toggle('visible', window.scrollY > 400); };
    window.addEventListener('scroll', toggleTopBtn, { passive: true });
    toggleTopBtn();
    topBtn.addEventListener('click', function(){ window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }
})();

(function(){
  var btn = document.getElementById('navToggle');
  var links = document.getElementById('navLinks');
  if (!btn || !links) return;
  btn.addEventListener('click', function(){
    var isOpen = links.classList.toggle('open');
    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
  links.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){
      links.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    });
  });
})();
</script>

{% if site.instagramPosts.length %}
<script async src="https://www.instagram.com/embed.js"></script>
{% endif %}

<script>
(function(){
  // Capa clicável de vídeo (ver lib/video.js): só cria o iframe de verdade
  // (YouTube/Vimeo/Instagram) quando a pessoa clica no play, em vez de
  // carregar o player — e os scripts de rastreamento dele — em toda visita.
  document.addEventListener('click', function(e){
    var facade = e.target.closest('.video-facade');
    if (!facade) return;
    var src = facade.getAttribute('data-video-src');
    if (!src) return;
    var titulo = facade.getAttribute('data-video-title') || 'Vídeo';
    var allow = facade.getAttribute('data-video-allow') || '';
    var separador = src.indexOf('?') > -1 ? '&' : '?';

    var iframe = document.createElement('iframe');
    iframe.src = src + separador + 'autoplay=1';
    iframe.title = titulo;
    iframe.loading = 'lazy';
    iframe.allow = allow;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.setAttribute('allowfullscreen', '');

    facade.innerHTML = '';
    facade.classList.remove('video-facade');
    facade.appendChild(iframe);
  });
})();
</script>

</body>
</html>
