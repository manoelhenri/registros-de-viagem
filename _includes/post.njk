---
layout: base.njk
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title | escapeJson }}",
  "description": "{{ resumo | escapeJson }}",
  "datePublished": "{{ data | isoDate }}",
  {% if capa %}"image": "{{ capa }}",{% endif %}
  "url": "{{ site.url }}{{ page.url }}",
  "author": { "@type": "Person", "name": "{{ site.author | escapeJson }}" },
  "publisher": { "@type": "Person", "name": "{{ site.author | escapeJson }}" }
}
</script>

{% set thisPost = { url: page.url, data: { cidades: cidades, localizacaoMapa: localizacaoMapa, data: data, title: title } } %}
{% set destinosViagem = thisPost | destinosDoPost(destinos) %}
{% set parquesViagem = thisPost | parquesDoPost(parques) %}
{% set relacionados = thisPost | relacionadosDe(collections.posts, destinos, 3) %}
{% set rota = thisPost | rotaDoPost(destinos, parques) %}
{% set totalPaises = destinosViagem | paisesUnicos %}
{% set vizinhos = thisPost | vizinhosDoPost(collections.posts) %}

<nav class="breadcrumb breadcrumb--narrow" aria-label="Você está aqui">
  <a href="{{ '/' | url }}">Início</a>
  <span class="sep">→</span>
  <a href="{{ '/posts/' | url }}">Posts</a>
  <span class="sep">→</span>
  <span class="here">{{ title }}</span>
</nav>

<div class="post-hero">
  <a class="back-link" href="{{ '/posts/' | url }}">← voltar para todos os registros</a>
  <span class="coords">{{ coordenadas }}</span>
  <h1>{{ title }}</h1>
  <div class="post-meta">
    <span>📅 {{ data | dataAno }}</span>
    {% if cidades %}<span>✈️ {{ cidades }}</span>{% endif %}
    {% if duracao %}<span>🕓 {{ duracao }}</span>{% endif %}
    <span>📖 {{ content | readingTime }} min de leitura</span>
  </div>
</div>

<div class="post-cover">
  {% if videoCapa %}
    {{ videoCapa | videoEmbed(title) | safe }}
  {% elif capa %}
    <img src="{{ capa }}" alt="{{ title }}" fetchpriority="high" decoding="async">
    {% if capaCredito %}
      <p class="cover-credit">{% if capaFonte %}<a href="{{ capaFonte }}" target="_blank" rel="noopener">{{ capaCredito }}</a>{% else %}{{ capaCredito }}{% endif %}</p>
    {% endif %}
  {% else %}
    <div class="img-placeholder" style="aspect-ratio: 21 / 9;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
    </div>
  {% endif %}
</div>

{% if localizacaoMapa %}
<div class="map-embed">
  {{ localizacaoMapa | mapaEmbed(localizacaoMapa) | safe }}
</div>
{% endif %}

{% if duracao or rota.length %}
<div class="ficha-viagem">
  <div class="boarding-pass">
    <div class="bp-row">
      <span>Rota</span>
      <span>{{ coordenadas }}</span>
    </div>
    <div class="bp-row">
      <span>Data</span>
      <span>{{ data | dataAno }}</span>
    </div>
    <div class="bp-stats">
      {% if rota.length %}
      <div>
        <strong>{{ rota.length | pad2 }}</strong>
        <span>{% if rota.length == 1 %}PARADA{% else %}PARADAS{% endif %}</span>
      </div>
      {% endif %}
      {% if totalPaises %}
      <div>
        <strong>{{ totalPaises | pad2 }}</strong>
        <span>{% if totalPaises == 1 %}PAÍS{% else %}PAÍSES{% endif %}</span>
      </div>
      {% endif %}
      {% if duracao %}
      <div>
        <strong>{{ duracao }}</strong>
        <span>DURAÇÃO</span>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

{% set temFichaExtra = perfilViagem or transporte or hospedagem or melhorEpoca or tempoIdeal or destaquePessoal or repetiriaViagem or observacaoPratica %}
{% if temFichaExtra %}
<div class="ficha-extra">
  <h2>Detalhes da viagem</h2>
  <dl class="ficha-extra-grid">
    {% if perfilViagem %}<div><dt>Perfil</dt><dd>{{ perfilViagem }}</dd></div>{% endif %}
    {% if transporte %}<div><dt>Transporte</dt><dd>{{ transporte }}</dd></div>{% endif %}
    {% if hospedagem %}<div><dt>Hospedagem</dt><dd>{{ hospedagem }}</dd></div>{% endif %}
    {% if melhorEpoca %}<div><dt>Melhor época</dt><dd>{{ melhorEpoca }}</dd></div>{% endif %}
    {% if tempoIdeal %}<div><dt>Tempo ideal</dt><dd>{{ tempoIdeal }}</dd></div>{% endif %}
    {% if repetiriaViagem %}<div><dt>Repetiria a viagem?</dt><dd>{{ repetiriaViagem }}</dd></div>{% endif %}
  </dl>
  {% if destaquePessoal %}<p class="ficha-extra-destaque">"{{ destaquePessoal }}"</p>{% endif %}
  {% if observacaoPratica %}<p class="ficha-extra-obs"><strong>💡 Vale saber:</strong> {{ observacaoPratica }}</p>{% endif %}
</div>
{% endif %}

{% if rota.length > 1 %}
<div class="rota-visual">
  <h2>O roteiro, parada por parada</h2>
  <div class="rota-trilha">
    {% for parada in rota %}
    {% if parada.slug and parada.tipo == "parque" %}
      <a class="rota-pill" href="{{ '/parques/' | url }}{{ parada.slug }}/">{{ parada.nome }}</a>
    {% elif parada.slug %}
      <a class="rota-pill" href="{{ '/destinos/' | url }}{{ parada.slug }}/">{{ parada.nome }}</a>
    {% else %}
      <span class="rota-pill">{{ parada.nome }}</span>
    {% endif %}
    {% if not loop.last %}<span class="rota-seta">→</span>{% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

<article class="post-body">
  {{ content | safe }}
</article>

<div class="share-row">
  <span class="share-label">Compartilhar:</span>
  <a href="https://wa.me/?text={{ (title + ' — ' + site.url + page.url) | encodeURI }}" target="_blank" rel="noopener">WhatsApp</a>
  <a href="https://twitter.com/intent/tweet?text={{ title | encodeURI }}&url={{ (site.url + page.url) | encodeURI }}" target="_blank" rel="noopener">X</a>
  <a href="https://www.facebook.com/sharer/sharer.php?u={{ (site.url + page.url) | encodeURI }}" target="_blank" rel="noopener">Facebook</a>
</div>

{% if destinosViagem.length %}
<section class="chips-section">
  <h2>Destinos desta viagem</h2>
  <div class="chip-row">
    {% for d in destinosViagem %}
    <a class="place-chip" href="{{ '/destinos/' | url }}{{ d.slug }}/">
      <span class="pin">📍</span> {{ d.nome }}
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if parquesViagem.length %}
<section class="chips-section">
  <h2>Parques desta viagem</h2>
  <div class="chip-row">
    {% for p in parquesViagem %}
    <a class="place-chip" href="{{ '/parques/' | url }}{{ p.slug }}/">
      <span class="pin">{{ p.icone }}</span> {{ p.nome }}
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if relacionados.length %}
<section class="related-posts">
  <h2>Outros registros</h2>
  <div class="post-grid">
    {% for post in relacionados %}
      <a class="tag-card" href="{{ post.url }}">
        <span class="punch"></span>
        {% if post.data.capa %}
          <img src="{{ post.data.capa }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
        {% else %}
          <div class="img-placeholder" style="height:160px; margin-bottom:16px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M21 16l-5-5-4 4-3-3-5 5"/></svg>
          </div>
        {% endif %}
        <span class="coords">{{ post.data.coordenadas }}</span>
        <h4>{{ post.data.title }}</h4>
        <p class="snippet">{{ post.data.resumo }}</p>
      </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if vizinhos.anterior or vizinhos.proximo %}
<nav class="post-adjacent-nav" aria-label="Navegação entre viagens">
  {% if vizinhos.anterior %}
    <a class="adjacent-link adjacent-prev" href="{{ vizinhos.anterior.url }}">
      <span class="adjacent-label">← Viagem anterior</span>
      <span class="adjacent-title">{{ vizinhos.anterior.data.title }}</span>
    </a>
  {% else %}
    <span></span>
  {% endif %}
  {% if vizinhos.proximo %}
    <a class="adjacent-link adjacent-next" href="{{ vizinhos.proximo.url }}">
      <span class="adjacent-label">Próxima viagem →</span>
      <span class="adjacent-title">{{ vizinhos.proximo.data.title }}</span>
    </a>
  {% endif %}
</nav>
{% endif %}

<div class="post-nav">
  <a href="{{ '/' | url }}">← voltar para o início</a>
</div>
